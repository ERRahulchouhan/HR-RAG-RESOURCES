# Copy this file to .env and fill in your real values.
# .env is never committed — only this .example file is.
# OpenAI — fallback chat model and embeddings
OPENAI_API_KEY=your-openai-api-key-here

# Groq — primary chat model and evaluation judge
GROQ_API_KEY=your-groq-api-key-here

# Models — optional overrides (defaults in hr_assistant/config.py).
# LLM_MODEL_NAME is the Groq primary; FALLBACK_MODEL_NAME is the OpenAI model.
# Embedding model changes require `python ingest.py --force` because they
# change the vector dimensions in Qdrant.
# LLM_MODEL_NAME=openai/gpt-oss-20b
# FALLBACK_MODEL_NAME=gpt-4o-mini
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# Qdrant Cloud — the vector store
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=hr_policies

# --- Guardrails / cache (the secure pipeline app.py + main.py run) ---

# Separate Qdrant collection holding HR docs + the noise corpus together
# (used by demo_reliability.py / redteam_test.py)
QDRANT_NOISY_COLLECTION_NAME=hr_policies_noisy_demo

# Input/output safety guardrail — uses the OpenAI model by default; "none"
# disables it.
GUARDRAIL_PROVIDER=openai

# Optional tuning — all have sensible defaults; leave unset unless tuning.
#   GUARDRAIL_FAIL_OPEN_INPUT=false    # on a provider ERROR: input fails closed
#   GUARDRAIL_FAIL_OPEN_OUTPUT=true    #                       output fails open
#   GUARDRAIL_HISTORY_TURNS=6          # recent USER turns screened with each question (0 = off)
#   SEMANTIC_CACHE_MAX_ENTRIES=500     # oldest evicted past this
#   SEMANTIC_CACHE_TTL_SECONDS=3600    # cache entry lifetime (0 = never expire)

# LangSmith — tracing for the app + datasets/experiments for evaluate.py.
# Free API key at smith.langchain.com. Set LANGSMITH_TRACING=true to send
# traces; the app shows a green/grey status line in the sidebar.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=hr-policy-assistant

# GROQ_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_MODEL_NAME=openai/gpt-oss-120b
